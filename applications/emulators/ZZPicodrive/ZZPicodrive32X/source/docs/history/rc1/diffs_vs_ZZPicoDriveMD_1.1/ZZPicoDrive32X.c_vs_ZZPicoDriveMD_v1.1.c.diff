+    __asm__ volatile("move.l %%sp,%0" : "=r"(sp));
+    printf("STACK [%s]: sp=0x%08lx lower=0x%08lx upper=0x%08lx used=%lu free=%lu\n",
+           tag, sp, (ULONG)t->tc_SPLower, (ULONG)t->tc_SPUpper,
+           (ULONG)t->tc_SPUpper - sp, sp - (ULONG)t->tc_SPLower);
