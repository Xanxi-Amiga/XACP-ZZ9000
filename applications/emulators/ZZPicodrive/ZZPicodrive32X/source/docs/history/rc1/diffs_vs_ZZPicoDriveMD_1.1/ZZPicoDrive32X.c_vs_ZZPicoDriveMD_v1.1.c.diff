+    for(w=0; w<150; w++){ if(rd32(shared,SH_STATUS)==ST_STOPPED) break; Delay(1); }
+    printf("  STATUS=0x%02lx after %ld more ticks (%s)\n", rd32(shared,SH_STATUS), w,
