+#ifdef ZZPICO_SMS_FM_MIX
+/* ZZPicoDriveSMS v1.2: audio mixer of the Japanese Master System (315-5297),
+   port $F2 bits D1 D0 (Genesis Plus GX, memz80.c):
+     00 PSG only (power-on)  01 FM only  10 PSG and FM muted  11 PSG and FM.
+   Applied in the Japan region only, as in Genesis Plus GX; elsewhere (and
+   before the game writes $F2) PSG and FM are both heard, as upstream.
+   Returns bit 0 = PSG audible, bit 1 = FM audible.  A muted chip still runs
+   (its state advances), its output is discarded. */
+static int zz_sms_mix(void)
+{
+  unsigned c = Pico.ms.fm_ctl;
+  if (!(PicoIn.AHW & PAHW_SMS) || (PicoIn.AHW & (PAHW_GG|PAHW_SG|PAHW_SC)))
+    return 3;
+  if (!(Pico.m.hardware & PMS_HW_JAP) || !(Pico.m.hardware & PMS_HW_FM) || c == 0xff)
+    return 3;
+  switch (c & 3) {
+    case 0:  return 1;
+    case 1:  return 2;
+    case 2:  return 0;
+    default: return 3;
+  }
+}
+static s16 zz_psg_discard[2*1200];
+static void zz_psg_update(s16 *buffer, int length, int stereo)
+{
+  if (zz_sms_mix() & 1) { SN76496Update(buffer, length, stereo); return; }
+  while (length > 0) {              /* muted: run the PSG into a scratch buffer */
+    int n = length > 1200 ? 1200 : length;
+    SN76496Update(zz_psg_discard, n, stereo);
+    length -= n;
+  }
+}
+#define ZZ_PSG_UPDATE(b,l,s) zz_psg_update(b,l,s)
+#define ZZ_FM_AUDIBLE()      (zz_sms_mix() & 2)
+#else
+#define ZZ_PSG_UPDATE(b,l,s) SN76496Update(b,l,s)
+#define ZZ_FM_AUDIBLE()      1
+#endif
 static int (*PsndFMUpdate)(s32 *buffer, int length, int stereo, int is_buf_empty);
 
