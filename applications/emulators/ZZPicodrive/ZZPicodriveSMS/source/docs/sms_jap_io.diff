+/* ZZPicoDriveSMS Japanese I/O: Japanese console I/O.  On the Japanese Master System
+   (315-5297 I/O chip) the TH and TR pins set as outputs always read back 0 on
+   ports $DC/$DD; export consoles read back the output level.  Games use this
+   to tell the region: Wonder Boy III and others enable their YM2413 music
+   only on a Japanese console.  Upstream PicoDrive always reads back the
+   level, so such games stayed on the PSG even in the Japan region.  Same rule
+   as Genesis Plus GX (io_ctrl.c, region_code == REGION_JAPAN_NTSC); not for
+   Game Gear / SG-1000 / SC-3000. */
+#ifdef ZZPICO_SMS_JAP_IO
+#define ZZ_IOCTL_RD (((Pico.m.hardware & PMS_HW_JAP) && !(PicoIn.AHW & (PAHW_GG|PAHW_SG|PAHW_SC))) \
+                     ? (Pico.ms.io_ctl & 0x0f) : Pico.ms.io_ctl)
+#else
+#define ZZ_IOCTL_RD (Pico.ms.io_ctl)
+#endif
