+/* ==== ZZVirtuaRacing A1 : VFP, window statistics, OSD ==== */
+
+/* VFPv3: CPACR cp10/cp11 full access, then FPEXC.EN.  Returns FPEXC read back
+   (bit 30 set = enabled).  Must run before any floating-point instruction of
+   the core (Core1 rule: not all blobs activate it; 1.1 did not). */
+static u32 vfp_enable(void){
+    u32 v;
+    __asm__ volatile("mrc p15,0,%0,c1,c0,2":"=r"(v));
+    v|=(3u<<20)|(3u<<22);
+    __asm__ volatile("mcr p15,0,%0,c1,c0,2"::"r"(v):"memory");
+    __asm__ volatile("isb":::"memory");
+    __asm__ volatile("vmsr fpexc, %0"::"r"(1u<<30));
+    __asm__ volatile("isb":::"memory");
+    __asm__ volatile("vmrs %0, fpexc":"=r"(v));
+    return v;
+}
+
+/* PicoFrame() over a window of the last ZZVR_PF_WINDOW frames (600 = 10 s at
+   60 Hz): the launcher-independent measurement asked for A1 (quit during a race,
+   the window holds the race).  Cycles -> us at 666.667 cycles/us. */
+#define ZZVR_PF_WINDOW 600
+static u32 g_pfw[ZZVR_PF_WINDOW];
+static u32 g_pfw_i=0, g_pfw_n=0, g_pfw_sum=0;
+static u32 g_pf_last_us=0, g_pf_avg_us=0, g_pf_max_us=0;
+static u32 cyc_to_us(u32 cyc){ return (u32)(((unsigned long long)cyc*3ull)/2000ull); }
+static u8  g_pfw_drawn[ZZVR_PF_WINDOW];
+static u32 g_pfw_ndrawn=0;
+static void pf_window_add(u32 cyc, int drawn){
+    u32 us=cyc_to_us(cyc), i, mx=0;
+    if(us>65535u) us=65535u;
+    if(g_pfw_n==ZZVR_PF_WINDOW){ g_pfw_sum-=g_pfw[g_pfw_i]; g_pfw_ndrawn-=g_pfw_drawn[g_pfw_i]; } else g_pfw_n++;
+    g_pfw[g_pfw_i]=us; g_pfw_sum+=us; g_pfw_drawn[g_pfw_i]=(u8)(drawn?1:0); g_pfw_ndrawn+=g_pfw_drawn[g_pfw_i];
+    g_pfw_i=(g_pfw_i+1u)%ZZVR_PF_WINDOW;
+    for(i=0;i<g_pfw_n;i++) if(g_pfw[i]>mx) mx=g_pfw[i];
+    g_pf_last_us=us; g_pf_avg_us=g_pfw_sum/g_pfw_n; g_pf_max_us=mx;
+    shared[ZZVR_SH_PF_LAST_US]=us; shared[ZZVR_SH_PF_W_AVG_US]=g_pf_avg_us; shared[ZZVR_SH_PF_W_MAX_US]=mx;
+    shared[ZZVR_SH_W_FRAMES]=g_pfw_n; shared[ZZVR_SH_W_DRAWN]=g_pfw_ndrawn;
+}
+
+/* decimal helpers for the OSD (no stdio in the blob) */
+static char *osd_ms(char *d, u32 us){        /* "12.3" from microseconds, 4 chars, clamps at 99.9 */
+    u32 t=(us+50u)/100u; if(t>999u) t=999u;
+    d[0]=(char)('0'+t/100u); d[1]=(char)('0'+(t/10u)%10u); d[2]='.'; d[3]=(char)('0'+t%10u); return d+4;
+}
+static char *osd_hex(char *d, u32 v, int n){ static const char h[]="0123456789ABCDEF"; int i; for(i=n-1;i>=0;i--){ d[i]=h[v&15u]; v>>=4; } return d+n; }
+
+/* One 8-pixel text line in the top border of the P96 picture (NTSC 224: rows 0..7
+   are border).  Fields: build, PicoFrame last / window average / window maximum
+   in ms, X<ADEN bit>, master SH-2 pc, slave SH-2 pc.  Drawn after the
+   conversion, before the cache clean (same buffer, same frame). */
+static void osd_draw(u32 *buf, u32 pp){
+    char line[48]; char *d=line; u32 aden;
+    if(shared[ZZVR_SH_OSD]) return;
+#ifdef ZZVR_DRC
+    d[0]='A';d[1]='1';d[2]='B';d[3]='3'; d+=4;
+#else
+    d[0]='A';d[1]='1';d[2]='A';d[3]='3'; d+=4;
+#endif
+    *d++=' '; d=osd_ms(d,g_pf_last_us); *d++=' '; d=osd_ms(d,g_pf_avg_us); *d++=' '; d=osd_ms(d,g_pf_max_us);
+    aden=(PicoIn.AHW&PAHW_32X)?1u:0u;
+    *d++=' '; *d++='X'; *d++=(char)('0'+aden);
+    *d++=' '; d=osd_hex(d, aden?msh2.pc:0u, 8);
+    *d++=' '; d=osd_hex(d, aden?ssh2.pc:0u, 8);
+    *d=0;
+    draw_text(buf, pp, 0, 0, line, 0xFFFFFFFFu);
+}
+
+static void zzvr_publish_diag(void){
+    extern u32 zzvr_mmap_used, zzvr_sbrk_used, zzvr_mmap_fail;
+    shared[ZZVR_SH_AHW]=PicoIn.AHW;
+    shared[ZZVR_SH_MMAP_USED]=zzvr_mmap_used;
+    shared[ZZVR_SH_SBRK_USED]=zzvr_sbrk_used;
+    shared[ZZVR_SH_MMAP_FAIL]=zzvr_mmap_fail;
+    if(PicoIn.AHW&PAHW_32X){
+        shared[ZZVR_SH_X32_REG0]=Pico32x.regs[0];
+        shared[ZZVR_SH_X32_VDP0]=Pico32x.vdp_regs[0];
+        shared[ZZVR_SH_MSH2_PC]=msh2.pc;
+        shared[ZZVR_SH_SSH2_PC]=ssh2.pc;
+    }
+}
